# ==========================================
# .gitignore for .NET and Sensitive Data
# ==========================================

# Build and compilation outputs
[Bb]in/
[Oo]bj/
[Oo]ut/
msbuild.log
msbuild.err
msbuild.wrn

# User-specific and sensitive environment settings
*.user
*.userosscache
*.sln.docstates
*.suo
*.userprefs
*.local.json
*.local.json.user
appsettings.Production.json
appsettings.*.local.json

# Environment and secrets
.env
*.env
secrets.json
.vs/
.vscode/
.idea/

# Visual Studio files
.vs/
*.slnLaunch.user

# Operating System files
Thumbs.db
Desktop.ini
.DS_Store

# Temporary and cache files
*.tmp
*.log
*.bak
*.swp
