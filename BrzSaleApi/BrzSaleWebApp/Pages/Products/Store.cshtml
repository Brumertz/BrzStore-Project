@page
@model BrzSaleWebApp.Pages.Products.StoreModel
@{
    ViewData["Title"] = "Product Catalog";
    var isAuth = Model.IsAuthenticated;
}

<div class="container py-4">
    <!-- Header Section -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
        <div>
            <h1 class="h2 fw-bold text-primary mb-1">Product Catalog</h1>
            @if (isAuth)
            {
                <p class="text-muted mb-0">Manage products connected to the REST API (<code>https://localhost:7069</code>)</p>
            }
            else
            {
                <p class="text-muted mb-0">Browse available products. <a asp-area="Identity" asp-page="/Account/Login" class="fw-semibold text-primary">Log in</a> to add, edit or delete products.</p>
            }
        </div>
        @if (isAuth)
        {
            <div class="d-flex gap-2">
                <button class="btn btn-outline-secondary" onclick="seedSampleProducts()" title="Inserts 3 demo vehicles (Subaru BRZ, Toyota GR86, Mazda MX-5) into the database">
                    🚗 Load Sample Cars
                </button>
                <button class="btn btn-primary" onclick="openCreateModal()">
                    + New Product
                </button>
            </div>
        }
        else
        {
            <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-outline-primary">
                🔐 Login to Manage
            </a>
        }
    </div>

    <!-- Guest notice banner -->
    @if (!isAuth)
    {
        <div class="alert alert-info d-flex align-items-center gap-2 mb-4" role="alert">
            <span>🔒</span>
            <div>
                <strong>Read-only mode.</strong> You are browsing as a guest. <a asp-area="Identity" asp-page="/Account/Login" class="alert-link">Sign in</a> or <a asp-area="Identity" asp-page="/Account/Register" class="alert-link">register</a> to manage the product catalog.
            </div>
        </div>
    }

    <!-- Alert Notification Banner -->
    <div id="alert-banner" class="alert d-none alert-dismissible fade show" role="alert">
        <span id="alert-message"></span>
        <button type="button" class="btn-close" onclick="hideAlert()"></button>
    </div>

    <!-- Search and View Controls -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <div class="row g-3 align-items-center">
                <div class="col-md-6">
                    <div class="input-group">
                        <span class="input-group-text bg-light">🔍</span>
                        <input type="text" id="search-input" class="form-control" placeholder="Search by brand or model..." oninput="filterProducts()">
                    </div>
                </div>
                <div class="col-md-6 text-md-end">
                    <div class="btn-group" role="group">
                        <button type="button" class="btn btn-outline-primary active" id="btn-view-cards" onclick="setViewMode('cards')">
                            Card View
                        </button>
                        @if (isAuth)
                        {
                            <button type="button" class="btn btn-outline-primary" id="btn-view-table" onclick="setViewMode('table')">
                                Table View (CRUD)
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Loading Indicator -->
    <div id="loading-spinner" class="text-center py-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <p class="text-muted mt-2">Connecting to API at <code>localhost:7069</code>...</p>
    </div>

    <!-- Empty State -->
    <div id="empty-state" class="text-center py-5 d-none">
        <div class="display-6 text-muted mb-3">📦</div>
        <h4 class="text-secondary">No products found</h4>
        @if (isAuth)
        {
            <p class="text-muted">Create a new product or load sample data to get started.</p>
            <button class="btn btn-primary me-2" onclick="openCreateModal()">+ Create Product</button>
            <button class="btn btn-outline-secondary" onclick="seedSampleProducts()">Load 3 Samples</button>
        }
        else
        {
            <p class="text-muted">No products are currently available in the catalog.</p>
        }
    </div>

    <!-- Product Cards Grid Container -->
    <div id="products-cards" class="row row-cols-1 row-cols-md-3 g-4 d-none"></div>

    <!-- Product Table Container (authenticated users only) -->
    @if (isAuth)
    {
        <div id="products-table-container" class="card shadow-sm d-none">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Brand</th>
                            <th>Model</th>
                            <th>Year</th>
                            <th>Price</th>
                            <th>Engine</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody id="products-table-body"></tbody>
                </table>
            </div>
        </div>
    }
</div>

<!-- Modal: Create / Edit Product (authenticated users only) -->
@if (isAuth)
{
    <div class="modal fade" id="productModal" tabindex="-1" aria-labelledby="productModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="productModalLabel">New Product</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form id="productForm">
                        <input type="hidden" id="prod-id" />

                        <div class="row g-2 mb-3">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Brand *</label>
                                <input type="text" class="form-control" id="prod-brand" placeholder="e.g. Subaru" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Model *</label>
                                <input type="text" class="form-control" id="prod-model" placeholder="e.g. BRZ Premium" required />
                            </div>
                        </div>

                        <div class="row g-2 mb-3">
                            <div class="col-md-4">
                                <label class="form-label fw-semibold">Year *</label>
                                <input type="number" class="form-control" id="prod-year" value="2024" min="1990" max="2030" required />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-semibold">Price ($) *</label>
                                <input type="number" step="0.01" class="form-control" id="prod-price" placeholder="32000" required />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-semibold">Engine (cc)</label>
                                <input type="number" class="form-control" id="prod-engine" placeholder="2400" value="2400" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Category ID (24-hex string)</label>
                            <input type="text" class="form-control" id="prod-category-id" placeholder="Auto-generated if left empty" />
                            <div class="form-text">If left empty, a valid MongoDB ObjectId will be generated automatically.</div>
                        </div>

                        <div class="form-check form-switch mb-2">
                            <input class="form-check-input" type="checkbox" id="prod-on-sale" checked />
                            <label class="form-check-label" for="prod-on-sale">On Sale</label>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary" onclick="saveProduct()">Save Product</button>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
<script>
    // Pass authentication state from server to client-side JavaScript
    const IS_AUTHENTICATED = @(isAuth ? "true" : "false");
    const API_BASE_URL = "https://localhost:7069/api/v1.0/Products";
    let allProducts = [];
    let currentView = 'cards';
    let productModal = null;

    document.addEventListener("DOMContentLoaded", () => {
        if (IS_AUTHENTICATED) {
            productModal = new bootstrap.Modal(document.getElementById('productModal'));
        }
        loadProducts();
    });

    // Display temporary alert message
    function showAlert(message, type = 'success') {
        const banner = document.getElementById('alert-banner');
        const text = document.getElementById('alert-message');
        banner.className = `alert alert-${type} alert-dismissible fade show`;
        text.innerText = message;
        banner.classList.remove('d-none');
        setTimeout(() => hideAlert(), 5000);
    }

    function hideAlert() {
        document.getElementById('alert-banner').classList.add('d-none');
    }

    // Switch between card and table views (table only available when authenticated)
    function setViewMode(mode) {
        if (mode === 'table' && !IS_AUTHENTICATED) return;
        currentView = mode;
        const btnCards = document.getElementById('btn-view-cards');
        const btnTable = document.getElementById('btn-view-table');

        if (mode === 'cards') {
            btnCards.classList.add('active');
            if (btnTable) btnTable.classList.remove('active');
        } else {
            if (btnTable) btnTable.classList.add('active');
            btnCards.classList.remove('active');
        }
        renderView();
    }

    // Fetch all products from REST API
    async function loadProducts() {
        const spinner = document.getElementById('loading-spinner');
        const emptyState = document.getElementById('empty-state');
        spinner.classList.remove('d-none');
        emptyState.classList.add('d-none');

        try {
            const res = await fetch(API_BASE_URL);
            if (!res.ok) throw new Error("HTTP Status " + res.status);
            allProducts = await res.json();
            renderView();
        } catch (err) {
            showAlert("Could not connect to API at " + API_BASE_URL + ". Ensure BrzSaleApi is running.", "danger");
            allProducts = [];
            renderView();
        } finally {
            spinner.classList.add('d-none');
        }
    }

    // Filter products based on search query
    function getFilteredProducts() {
        const query = document.getElementById('search-input').value.toLowerCase().trim();
        if (!query) return allProducts;
        return allProducts.filter(p =>
            (p.brand && p.brand.toLowerCase().includes(query)) ||
            (p.model && p.model.toLowerCase().includes(query))
        );
    }

    function filterProducts() {
        renderView();
    }

    // Render the active view
    function renderView() {
        const products = getFilteredProducts();
        const cardsContainer = document.getElementById('products-cards');
        const tableContainer = document.getElementById('products-table-container');
        const emptyState = document.getElementById('empty-state');

        if (products.length === 0) {
            cardsContainer.classList.add('d-none');
            if (tableContainer) tableContainer.classList.add('d-none');
            emptyState.classList.remove('d-none');
            return;
        }

        emptyState.classList.add('d-none');

        // Only show table view for authenticated users
        if (currentView === 'table' && IS_AUTHENTICATED && tableContainer) {
            cardsContainer.classList.add('d-none');
            tableContainer.classList.remove('d-none');
            renderTable(products);
        } else {
            if (tableContainer) tableContainer.classList.add('d-none');
            cardsContainer.classList.remove('d-none');
            renderCards(products);
        }
    }

    // Render product cards — action buttons shown only for authenticated users
    function renderCards(products) {
        const container = document.getElementById('products-cards');
        container.innerHTML = '';

        products.forEach(p => {
            const col = document.createElement('div');
            col.className = 'col';

            const actionsHtml = IS_AUTHENTICATED ? `
                <div class="card-footer bg-white border-0 pt-0 pb-3 d-flex justify-content-end gap-2">
                    <button class="btn btn-sm btn-outline-primary" onclick="openEditModal('${p.id}')">✏️ Edit</button>
                    <button class="btn btn-sm btn-outline-danger" onclick="deleteProduct('${p.id}')">🗑️ Delete</button>
                </div>` : '';

            col.innerHTML = `
                <div class="card h-100 shadow-sm border-0 border-top border-4 ${p.onSale ? 'border-success' : 'border-primary'}">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="card-title fw-bold text-dark mb-0">${p.brand} ${p.model}</h5>
                            ${p.onSale ? '<span class="badge bg-success">On Sale</span>' : ''}
                        </div>
                        <h4 class="text-primary fw-bold mb-3">$${Number(p.price).toLocaleString()}</h4>
                        <ul class="list-unstyled text-muted small mb-0">
                            <li><strong>Year:</strong> ${p.year}</li>
                            <li><strong>Engine:</strong> ${p.engineSize} cc</li>
                            <li><strong>ID:</strong> <code class="text-secondary">${p.id || 'N/A'}</code></li>
                        </ul>
                    </div>
                    ${actionsHtml}
                </div>
            `;
            container.appendChild(col);
        });
    }

    // Render product table rows — only for authenticated users
    function renderTable(products) {
        const tbody = document.getElementById('products-table-body');
        tbody.innerHTML = '';

        products.forEach(p => {
            const tr = document.createElement('tr');
            tr.innerHTML = `
                <td class="fw-bold">${p.brand}</td>
                <td>${p.model}</td>
                <td>${p.year}</td>
                <td class="fw-bold text-primary">$${Number(p.price).toLocaleString()}</td>
                <td>${p.engineSize} cc</td>
                <td>${p.onSale ? '<span class="badge bg-success">On Sale</span>' : '<span class="badge bg-secondary">Standard</span>'}</td>
                <td class="text-end">
                    <button class="btn btn-sm btn-outline-primary me-1" onclick="openEditModal('${p.id}')">Edit</button>
                    <button class="btn btn-sm btn-outline-danger" onclick="deleteProduct('${p.id}')">Delete</button>
                </td>
            `;
            tbody.appendChild(tr);
        });
    }

    // Guard: block management actions if user is not authenticated
    function requireAuth(action) {
        if (!IS_AUTHENTICATED) {
            showAlert("You must be logged in to perform this action.", "warning");
            return false;
        }
        return true;
    }

    // Generate a 24-character hex ObjectId
    function generateRandomHex24() {
        return [...Array(24)].map(() => Math.floor(Math.random() * 16).toString(16)).join('');
    }

    // Open modal to create a new product
    function openCreateModal() {
        if (!requireAuth()) return;
        document.getElementById('productModalLabel').innerText = "New Product";
        document.getElementById('prod-id').value = "";
        document.getElementById('prod-brand').value = "";
        document.getElementById('prod-model').value = "";
        document.getElementById('prod-year').value = 2024;
        document.getElementById('prod-price').value = "";
        document.getElementById('prod-engine').value = 2400;
        document.getElementById('prod-category-id').value = generateRandomHex24();
        document.getElementById('prod-on-sale').checked = true;
        productModal.show();
    }

    // Open modal pre-filled with existing product data
    function openEditModal(id) {
        if (!requireAuth()) return;
        const p = allProducts.find(item => item.id === id);
        if (!p) return;

        document.getElementById('productModalLabel').innerText = "Edit Product";
        document.getElementById('prod-id').value = p.id;
        document.getElementById('prod-brand').value = p.brand;
        document.getElementById('prod-model').value = p.model;
        document.getElementById('prod-year').value = p.year;
        document.getElementById('prod-price').value = p.price;
        document.getElementById('prod-engine').value = p.engineSize;
        document.getElementById('prod-category-id').value = p.categoryId || generateRandomHex24();
        document.getElementById('prod-on-sale').checked = p.onSale;
        productModal.show();
    }

    // Save product — create (POST) or update (PUT)
    async function saveProduct() {
        if (!requireAuth()) return;

        const id = document.getElementById('prod-id').value;
        const brand = document.getElementById('prod-brand').value.trim();
        const model = document.getElementById('prod-model').value.trim();
        const year = parseInt(document.getElementById('prod-year').value, 10);
        const price = parseFloat(document.getElementById('prod-price').value);
        const engineSize = parseInt(document.getElementById('prod-engine').value, 10) || 0;
        let categoryId = document.getElementById('prod-category-id').value.trim();
        const onSale = document.getElementById('prod-on-sale').checked;

        if (!brand || !model || isNaN(price)) {
            alert("Please fill in Brand, Model, and Price.");
            return;
        }

        if (!categoryId || categoryId.length !== 24) {
            categoryId = generateRandomHex24();
        }

        const payload = {
            brand, model, year, price, onSale, engineSize,
            categoryId,
            category: { id: categoryId, brand }
        };

        try {
            if (id) {
                // Update existing product (PUT)
                payload.id = id;
                const res = await fetch(`${API_BASE_URL}/${id}`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                if (!res.ok) throw new Error("Update failed: " + (await res.text()));
                showAlert("Product updated successfully!");
            } else {
                // Create new product (POST)
                const res = await fetch(API_BASE_URL, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                if (!res.ok) throw new Error("Creation failed: " + (await res.text()));
                showAlert("Product created successfully!");
            }
            productModal.hide();
            await loadProducts();
        } catch (err) {
            alert("Error: " + err.message);
        }
    }

    // Delete a product by ID
    async function deleteProduct(id) {
        if (!requireAuth()) return;
        if (!confirm("Are you sure you want to delete this product?")) return;

        try {
            const res = await fetch(`${API_BASE_URL}/${id}`, { method: 'DELETE' });
            if (!res.ok) throw new Error("Delete failed");
            showAlert("Product deleted successfully.");
            await loadProducts();
        } catch (err) {
            alert("Error: " + err.message);
        }
    }

    // Seed 3 sample products into the database
    async function seedSampleProducts() {
        if (!requireAuth()) return;

        const samples = [
            { brand: "Subaru", model: "BRZ Limited", year: 2024, price: 31995, engineSize: 2400, onSale: true },
            { brand: "Toyota", model: "GR86 Premium", year: 2024, price: 33500, engineSize: 2400, onSale: false },
            { brand: "Mazda", model: "MX-5 Miata RF", year: 2023, price: 36000, engineSize: 2000, onSale: true }
        ];

        let createdCount = 0;
        for (const s of samples) {
            const catId = generateRandomHex24();
            const payload = { ...s, categoryId: catId, category: { id: catId, brand: s.brand } };
            try {
                const res = await fetch(API_BASE_URL, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                if (res.ok) createdCount++;
            } catch (err) {
                console.error(err);
            }
        }

        showAlert(`Successfully loaded ${createdCount} sample products (Subaru BRZ, Toyota GR86, Mazda MX-5).`);
        await loadProducts();
    }
</script>
}
